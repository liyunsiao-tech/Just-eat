# Copy this file to .env for local development. Never commit .env.
PORT=4173

# Google Maps JavaScript browser key.
# Restrict it by HTTP referrer, API, and quota in Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=

# Server-side OpenAI-compatible chat completion settings.
# Leave blank to use the weighted-random fallback automatically.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=4500
