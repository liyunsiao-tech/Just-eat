# Copy this file to .env for local development. Never commit .env.
PORT=4173

# Google Maps JavaScript browser key.
# Restrict it by HTTP referrer, API, and quota in Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=

# Server-side Groq OpenAI-compatible chat completion settings.
# Leave AI_API_KEY blank to use the weighted-random fallback automatically.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_TIMEOUT_MS=5000
